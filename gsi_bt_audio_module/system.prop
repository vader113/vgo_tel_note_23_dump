# Keep NOTE_23 codec capability mask from stock vendor
persist.bluetooth.a2dp_offload.cap=sbc-aac

# IMPORTANT: do NOT force BluetoothAudio HAL disabled on GSI.
# The previous setting caused A2DP start/stop loops with speaker fallback.
persist.bluetooth.bluetooth_audio_hal.disabled=false
persist.vendor.bluetooth.bluetooth_audio_hal.disabled=false

# Keep LE audio offload disabled for compatibility with mixed GSI/vendor stacks
persist.bluetooth.leaudio_offload.disabled=true
