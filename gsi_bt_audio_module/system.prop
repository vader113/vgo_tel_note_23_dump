# Keep A2DP offload behavior aligned with stock vendor build.prop
persist.bluetooth.a2dp_offload.cap=sbc-aac
persist.bluetooth.a2dp_offload.disabled=true

# Force legacy Bluetooth audio path on GSI to avoid incompatible bluetooth_audio HAL routing
persist.bluetooth.bluetooth_audio_hal.disabled=true
persist.vendor.bluetooth.bluetooth_audio_hal.disabled=true

# Disable LE Audio offload to avoid route conflicts on mismatched GSI stacks
persist.bluetooth.leaudio_offload.disabled=true
